#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
if command -v pwsh >/dev/null 2>&1; then
  ps_command=pwsh
else
  ps_command=powershell.exe
fi

refs_file=$(mktemp)
trap 'rm -f "$refs_file"' EXIT HUP INT TERM
cat > "$refs_file"

exec "$ps_command" -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/verify-publish-identity.ps1" -Mode Push -RemoteName "$1" -RemoteUrl "$2" -PushRefsFile "$refs_file"
